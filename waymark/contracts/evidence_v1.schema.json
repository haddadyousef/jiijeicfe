{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "waymark.evidence.v1",
  "title": "Waymark evidence line v1 (one JSON object per line of evidence.jsonl)",
  "description": "No walker coordinates, no device id. Never use `t` or `kind` as a field name (the base trip-log writer rewrites them to field_t and field_kind). Numeric sensor fields are null when the sensor did not apply (for example a spotter tap has no lidar coverage).",
  "type": "object",
  "required": ["schema", "label_id", "outcome", "sensor", "build", "ts"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "waymark.evidence.v1" },
    "label_id": { "type": "string", "pattern": "^ps:[0-9]+$" },
    "outcome": { "enum": ["confirmed", "contradicted", "unverifiable"] },
    "sensor": { "enum": ["lidar_torso", "lidar_head", "ground", "spotter", "vision"] },
    "dist_m": { "type": ["number", "null"], "minimum": 0 },
    "along_m": { "type": ["number", "null"] },
    "gps_acc_m": { "type": ["number", "null"], "minimum": 0 },
    "speed_mps": { "type": ["number", "null"], "minimum": 0 },
    "tilt_deg": { "type": ["number", "null"] },
    "torso_cover": { "type": ["boolean", "null"] },
    "head_cover": { "type": ["boolean", "null"] },
    "build": { "type": "string", "minLength": 1 },
    "ts": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
