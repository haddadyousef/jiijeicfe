{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "waymark.priors.v1",
  "title": "Waymark priors bundle v1 (producer contract, strict)",
  "description": "What the pipeline must emit. Decoders (Swift) are tolerant: unknown extra fields are ignored and unknown `type` strings decode to `other`. Semantic rules that JSON Schema cannot express are in ref/validate.py (id equals source_cluster_id, bbox ordering, at most 6 decimals, labels sorted ascending by source_cluster_id, no duplicate ids).",
  "type": "object",
  "required": ["schema", "generated_at", "source", "bbox_lnglat", "labels"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "waymark.priors.v1" },
    "generated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "source": {
      "type": "object",
      "required": ["name", "license", "base_url", "street_geometry"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "base_url": { "type": "string", "minLength": 1 },
        "street_geometry": { "type": "string", "minLength": 1 }
      }
    },
    "bbox_lnglat": {
      "description": "[minLng, minLat, maxLng, maxLat], longitude first, like the Project Sidewalk API.",
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "type": "number" }
    },
    "labels": {
      "type": "array",
      "maxItems": 20000,
      "items": { "$ref": "#/$defs/label" }
    }
  },
  "$defs": {
    "nullableInt": { "type": ["integer", "null"] },
    "nullableMonth": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
    },
    "label": {
      "type": "object",
      "required": [
        "id", "type", "lat", "lng", "severity", "tags",
        "n_agree", "n_disagree", "n_unsure", "cluster_size",
        "street_edge_id", "intersection_id", "osm_way_id",
        "imagery_date", "label_date", "source_cluster_id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^ps:[0-9]+$" },
        "type": {
          "description": "Open enum. Producer emits one of: curb_ramp, missing_curb_ramp, obstacle, surface_problem, no_sidewalk, crosswalk, other. Decoders map any other string to `other`.",
          "type": "string",
          "minLength": 1
        },
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lng": { "type": "number", "minimum": -180, "maximum": 180 },
        "severity": { "type": ["number", "null"], "minimum": 1, "maximum": 3 },
        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "n_agree": { "type": "integer", "minimum": 0 },
        "n_disagree": { "type": "integer", "minimum": 0 },
        "n_unsure": { "type": "integer", "minimum": 0 },
        "cluster_size": { "type": "integer", "minimum": 1 },
        "street_edge_id": { "$ref": "#/$defs/nullableInt" },
        "intersection_id": { "$ref": "#/$defs/nullableInt" },
        "osm_way_id": { "$ref": "#/$defs/nullableInt" },
        "imagery_date": { "$ref": "#/$defs/nullableMonth" },
        "label_date": { "$ref": "#/$defs/nullableMonth" },
        "source_cluster_id": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
